# Copy this file to .env and fill in your own values before running the server.

# Login for the admin dashboard (admin.html)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-password

# Any long random string — used to sign the login session cookie
SESSION_SECRET=change-this-to-a-long-random-string

# Port the server listens on (optional, defaults to 3000)
PORT=3000

# PostgreSQL connection — point this at a running Postgres server (Docker via
# docker-compose.yml, local install, or a cloud-hosted provider like Neon or
# Supabase; see README.md for setup options). With docker-compose.yml, this
# same DB_USER/DB_PASSWORD/DB_NAME also configures the container itself, so
# just pick values here first and the database gets created automatically.
#
# ALTERNATIVE: if your host gives you a single connection string instead
# (Railway's Postgres plugin, Neon, Supabase, etc. all do this), set
# DATABASE_URL instead of the five DB_* vars below — it takes priority
# when both are present. Looks like:
# DATABASE_URL=postgresql://user:password@host:port/dbname
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_NAME=signal_signage

# Cloudflare R2 (file storage) — where uploaded images/video/audio actually
# live. See README.md "Setting up Cloudflare R2" for how to get each value.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=signal-signage
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev
